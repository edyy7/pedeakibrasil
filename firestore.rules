rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fase piloto: qualquer pessoa autenticada (login anônimo do app) lê e escreve.
    // Antes de abrir ao público, troque por login real + regras por papel (cliente/loja/motoboy/ADM).
    match /pedidos/{id}      { allow read, write: if request.auth != null; }
    match /ocorrencias/{id}  { allow read, write: if request.auth != null; }
    match /lojas/{id}        { allow read, write: if request.auth != null; }
    match /meta/{id}         { allow read, write: if request.auth != null; }
  }
}
