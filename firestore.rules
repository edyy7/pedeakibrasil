rules_version = '2';
// PedeAí Brasil — regras de segurança do Firestore.
// Cada empresa fica em /empresas/{codigo}/... e só o que a regra libera pode ser lido ou gravado.
// Publique em: Firebase Console > Firestore Database > Regras (cole tudo e clique em Publicar).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funções ----------
    function logado() { return request.auth != null; }
    function comSenha() { return logado() && request.auth.token.firebase.sign_in_provider in ['password', 'google.com']; }  // conta de verdade (e-mail/senha ou Google); anônimo não vale
    function criador() { return comSenha() && request.auth.token.email == 'edinaldooliveiradesouza@gmail.com' && request.auth.token.email_verified == true; }
    function libOk(e, d) { return exists(lojaDoc(e, d.split('_')[1])) && get(lojaDoc(e, d.split('_')[1])).data.get('lib', false) == true; }
    function empDoc(e) { return /databases/$(database)/documents/empresas/$(e); }
    function dono(e) { return logado() && exists(empDoc(e)) && request.auth.uid in get(empDoc(e)).data.donos; }
    function entDoc(e) { return /databases/$(database)/documents/empresas/$(e)/ent/$(request.auth.uid); }
    function entAprov(e) { return comSenha() && exists(entDoc(e)) && get(entDoc(e)).data.get('ap', 1) == 1; }
    function lojaDoc(e, rid) { return /databases/$(database)/documents/empresas/$(e)/lojas/$(string(rid)); }
    function acessoDoc(e, rid) { return /databases/$(database)/documents/empresas/$(e)/acessos/$(string(rid) + '_' + request.auth.uid); }
    function acessoOk(e, rid) { return comSenha() && exists(acessoDoc(e, rid)) && get(acessoDoc(e, rid)).data.get('status', '') == 'autorizado'; }
    function lojaDono(e, rid) { return exists(lojaDoc(e, rid)) ? get(lojaDoc(e, rid)).data.get('dono', '') : ''; }
    function segDoc(e, oid) { return /databases/$(database)/documents/empresas/$(e)/seg/$(string(oid)); }
    // códigos de retirada/entrega: ficam em /seg (lido só pelo cliente e pelo lojista do pedido) e são conferidos AQUI, no servidor.
    // Pedidos antigos (sem /seg) continuam valendo com o código gravado no próprio pedido.
    function codRet(e, id) { return exists(segDoc(e, id)) ? get(segDoc(e, id)).data.get('rc', '') : resource.data.get('rc', ''); }
    function codEnt(e, id) { return exists(segDoc(e, id)) ? get(segDoc(e, id)).data.get('cc', '') : resource.data.get('cc', ''); }
    function pedDoc(e, oid) { return /databases/$(database)/documents/empresas/$(e)/pedidos/$(string(oid)); }
    function so(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    function mudou(c) { return request.resource.data.get(c, null) != resource.data.get(c, null); }

    // ---------- empresa: só os donos administram ----------
    match /empresas/{e} {
      allow read: if logado();
      // primeiro acesso: a conta (e-mail e senha) que ativar vira dona; depois disso ninguém mais cria
      allow create: if comSenha()
        && request.resource.data.keys().hasOnly(['donos', 'ts'])
        && request.resource.data.donos == [request.auth.uid];
      allow update: if dono(e) && request.resource.data.donos.hasAll([request.auth.uid]);
      allow delete: if false;
    }

    // ---------- lojas: cardápio público para quem está logado; edição só do dono da loja ----------
    match /empresas/{e}/lojas/{id} {
      allow read: if logado();
      allow create: if dono(e);   // v117: loja só é criada pela administração
      allow update: if dono(e) || (criador() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lib']))
        || (comSenha() && resource.data.get('dono', '') == request.auth.uid
            && request.resource.data.get('dono', '') == resource.data.get('dono', '')
            && request.resource.data.get('ap', 1) == resource.data.get('ap', 1)
            && !mudou('pl') && !mudou('em') && acessoOk(e, id))
        // assumir loja criada pela administração: sem dono; se a loja tem e-mail, só a conta verificada com esse e-mail
        || (comSenha() && resource.data.get('dono', '') == '' && so(['dono']) && request.resource.data.dono == request.auth.uid
            && (resource.data.get('em', '') == ''
                || (request.auth.token.email_verified == true && resource.data.get('em', '') == request.auth.token.email.lower())));
      allow delete: if dono(e) || (comSenha() && resource.data.get('dono', '') == request.auth.uid);   // o lojista pode excluir a própria loja ao excluir a conta
    }

    // ---------- entregadores ----------
    match /empresas/{e}/ent/{id} {
      // motoboy só entra por convite do lojista: o cadastro grava lojaConvite (id da loja) e lojaDono (uid do lojista, conferido aqui)
      // v109 (privacidade): entregador aprovado NÃO lê mais o cadastro (CNH/selfie) de outros entregadores; só o próprio
      allow read: if dono(e) || (logado() && resource.data.id == request.auth.uid) || criador()
        || (comSenha() && resource.data.get('lojaDono', '') == request.auth.uid && acessoOk(e, resource.data.get('lojaConvite', '')));   // v118.1: lojista revogado/pendente não lê motoboys
      allow create: if comSenha() && id == request.auth.uid
        && request.resource.data.id == request.auth.uid
        && request.resource.data.get('ap', 0) == 0
        && request.resource.data.get('lojaConvite', '') != ''
        && request.resource.data.get('lojaDono', '') == lojaDono(e, request.resource.data.get('lojaConvite', ''))
        && request.resource.data.get('ftSelfie', '') != ''
        && request.resource.data.get('ftCnh', '') != ''
        && request.resource.data.get('ftVeiculo', '') != '';
      allow update: if dono(e)
        // o próprio motoboy: pode reenviar fotos (aprovado volta a pendente) e ligar-se a uma loja se ainda não tiver
        || (comSenha() && resource.data.get('id', '') == request.auth.uid
            && (request.resource.data.get('ap', 1) == resource.data.get('ap', 1)
                || (resource.data.get('ap', 1) == 1 && request.resource.data.get('ap', 1) == 0))
            && (resource.data.get('lojaConvite', '') == ''
                || (request.resource.data.get('lojaConvite', '') == resource.data.get('lojaConvite', '')
                    && request.resource.data.get('lojaDono', '') == resource.data.get('lojaDono', ''))))
        // só o lojista que enviou o convite aprova, recusa ou suspende
        || (comSenha() && resource.data.get('lojaDono', '') == request.auth.uid
            && so(['ap']) && request.resource.data.get('ap', 0) in [-1, 0, 1]);
      allow delete: if dono(e) || (comSenha() && resource.data.get('id', '') == request.auth.uid);   // o próprio motoboy pode excluir a conta (apaga CNH e selfie)
    }

    // ---------- pedidos: cliente vê só os seus, lojista só os da sua loja, entregador só os dele ----------
    match /empresas/{e}/pedidos/{id} {
      allow read: if dono(e)
        || (logado() && resource.data.cid == request.auth.uid)
        || (comSenha() && resource.data.get('ld', '') == request.auth.uid && acessoOk(e, resource.data.rid))   // v118.1: leitura só com acesso autorizado na loja do pedido
        || (logado() && resource.data.en == request.auth.uid)
        // v110: o entregador NÃO lê mais o pedido inteiro antes de aceitar; ele vê o cartão em /corridas
        || criador();
      allow create: if dono(e)
        || (comSenha() && request.resource.data.cid == request.auth.uid
            && request.resource.data.st == 'novo'
            && string(request.resource.data.id) == id
            && existsAfter(segDoc(e, id))
            && request.resource.data.ld == lojaDono(e, request.resource.data.rid))
        || (comSenha() && request.resource.data.ld == request.auth.uid
            && string(request.resource.data.id) == id
            && existsAfter(segDoc(e, id))
            && lojaDono(e, request.resource.data.rid) == request.auth.uid
            && acessoOk(e, request.resource.data.rid));   // v118.2: lojista revogado não cria pedido
      allow update: if dono(e)
        // cliente: avaliar/gorjeta, ou cancelar enquanto ainda não foi aceito pela loja
        || (resource.data.get('cid', '') == request.auth.uid && so(['gj', 'gjt', 'gjm', 'av']))
        // cliente: confirmar que recebeu (a corrida precisa estar em rota ou já entregue)
        || (resource.data.get('cid', '') == request.auth.uid && so(['cr', 'st', 'dt'])
            && resource.data.st in ['rota', 'entregue'] && request.resource.data.st == 'entregue')
        || (resource.data.get('cid', '') == request.auth.uid && so(['st', 'cn', 'mot'])
            && resource.data.st in ['novo', 'preparo', 'pronto'] && (resource.data.get('en', null) == null || resource.data.en == '')
            && request.resource.data.st == 'cancelado')
        // lojista dono da loja do pedido
        || (comSenha() && resource.data.get('ld', '') == request.auth.uid && acessoOk(e, resource.data.rid)   // v118.2: lojista revogado não altera pedido
            && so(['st', 'pr', 'mot', 'snd', 'tel', 'ds', 'cn', 'rt'])
            && (!mudou('st') || request.resource.data.st in ['preparo', 'pronto', 'cancelado']))
        // entregador aprovado recusando uma corrida pronta: só acrescenta o próprio uid em rcs
        || (entAprov(e) && resource.data.st == 'pronto' && so(['rcs'])
            && request.resource.data.rcs.hasAll(resource.data.get('rcs', []))
            && request.resource.data.rcs.size() == resource.data.get('rcs', []).size() + 1
            && request.auth.uid in request.resource.data.rcs)
        // entregador aprovado aceitando uma entrega pronta (e não direcionada a outro)
        || (entAprov(e) && resource.data.st == 'pronto' && request.resource.data.st == 'aceito'
            && request.resource.data.en == request.auth.uid
            && so(['st', 'en', 'enn', 'env', 'etel', 'aat'])
            && resource.data.get('ds', '') in ['', request.auth.uid])
        // entregador dono da entrega
        || (comSenha() && resource.data.get('en', '') == request.auth.uid
            && so(['st', 'pos', 'pt', 'ac', 'ar', 'rtm', 'kr', 'kd', 'ph', 'dt'])
            && (!mudou('st')
                // aceito -> rota: precisa do código de retirada certo
                || (request.resource.data.st == 'rota' && resource.data.st == 'aceito'
                    && request.resource.data.get('kr', '') != ''
                    && request.resource.data.get('kr', '') == codRet(e, id))
                // rota -> entregue: precisa do código de entrega certo (o que só o cliente sabe)
                || (request.resource.data.st == 'entregue' && resource.data.st == 'rota'
                    && request.resource.data.get('kd', '') != ''
                    && request.resource.data.get('kd', '') == codEnt(e, id))));
      allow delete: if dono(e);
    }

    // ---------- v110: cartão da corrida (sem endereço nem telefone do cliente) ----------
    // O lojista (e a administração) grava o cartão quando o pedido fica pronto; o entregador aprovado só lê cartões "pronto"
    // e só pode aceitar (st pronto -> aceito, en = ele mesmo). Dados do cliente continuam só no pedido.
    match /empresas/{e}/corridas/{id} {
      allow read: if dono(e) || criador()
        || (comSenha() && resource.data.get('ld', '') == request.auth.uid && acessoOk(e, resource.data.rid))   // v118.1
        || (entAprov(e) && resource.data.st == 'pronto')
        || (logado() && resource.data.get('en', '') == request.auth.uid);
      allow create: if dono(e)
        || (comSenha() && string(request.resource.data.id) == id
            && request.resource.data.ld == request.auth.uid
            && lojaDono(e, request.resource.data.rid) == request.auth.uid && acessoOk(e, request.resource.data.rid)   // v118.2
            && !request.resource.data.keys().hasAny(['tel', 'ad', 'gl', 'cid', 'cn', 'cl', 'cc', 'rc', 'ob', 'ph']));
      allow update: if dono(e)
        || (comSenha() && resource.data.get('ld', '') == request.auth.uid && acessoOk(e, resource.data.rid) && request.resource.data.ld == resource.data.ld   // v118.2
            && !request.resource.data.keys().hasAny(['tel', 'ad', 'gl', 'cid', 'cn', 'cl', 'cc', 'rc', 'ob', 'ph']))
        || (entAprov(e) && resource.data.st == 'pronto' && request.resource.data.st == 'aceito'
            && request.resource.data.en == request.auth.uid && so(['st', 'en'])
            && resource.data.get('ds', '') in ['', request.auth.uid]);
      allow delete: if dono(e) || (comSenha() && resource.data.get('ld', '') == request.auth.uid && acessoOk(e, resource.data.rid));   // v118.2
    }

    // ---------- mensagens: só quem participa do pedido; grupo só entregador aprovado ----------
    match /empresas/{e}/msgs/{id} {
      allow read: if dono(e)
        || (logado() && resource.data.oid == 'cfg')
        || (logado() && resource.data.pc == request.auth.uid)
        || (comSenha() && resource.data.get('pl', '') == request.auth.uid && acessoOk(e, resource.data.rid))   // v118.2: conversa da loja só com acesso autorizado
        || (logado() && resource.data.pe == request.auth.uid)
        || (entAprov(e) && resource.data.ch == 'gp');
      allow create: if (dono(e) && request.resource.data.oid == 'cfg')
        || (entAprov(e) && request.resource.data.ch == 'gp' && request.resource.data.en == request.auth.uid)
        || (logado() && request.resource.data.ch in ['cl', 'lj']
            && request.auth.uid in [request.resource.data.pc, request.resource.data.pl, request.resource.data.pe]
            && exists(pedDoc(e, request.resource.data.oid))
            && get(pedDoc(e, request.resource.data.oid)).data.get('cid', '') == request.resource.data.pc
            && get(pedDoc(e, request.resource.data.oid)).data.get('ld', '') == request.resource.data.pl
            && get(pedDoc(e, request.resource.data.oid)).data.get('en', '') == request.resource.data.pe
            && request.resource.data.get('rid', get(pedDoc(e, request.resource.data.oid)).data.rid) == get(pedDoc(e, request.resource.data.oid)).data.rid
            && (request.auth.uid != request.resource.data.pl || acessoOk(e, get(pedDoc(e, request.resource.data.oid)).data.rid)));   // v118.2: lojista revogado não escreve na conversa
      allow update, delete: if dono(e);
    }

    // ---------- códigos secretos do pedido: só o cliente e o lojista do pedido leem; o entregador NÃO lê (a conferência é feita nas regras de pedidos) ----------
    match /empresas/{e}/seg/{id} {
      allow read: if dono(e)
        || (logado() && resource.data.cid == request.auth.uid)
        || (comSenha() && resource.data.get('ld', '') == request.auth.uid && acessoOk(e, resource.data.rid));   // v118.2: códigos só com acesso autorizado na loja
      allow create: if comSenha()
        && string(request.resource.data.id) == id
        && request.resource.data.keys().hasOnly(['id', 'cid', 'ld', 'rid', 'cc', 'rc'])
        && request.resource.data.get('rid', getAfter(pedDoc(e, id)).data.rid) == getAfter(pedDoc(e, id)).data.rid
        && request.resource.data.cc is string && request.resource.data.cc.size() == 4
        && request.resource.data.rc is string && request.resource.data.rc.size() == 4
        && (request.resource.data.cid == request.auth.uid || request.resource.data.ld == request.auth.uid)
        && !exists(pedDoc(e, id)) && existsAfter(pedDoc(e, id))
        && getAfter(pedDoc(e, id)).data.get('cid', '') == request.resource.data.cid
        && getAfter(pedDoc(e, id)).data.get('ld', '') == request.resource.data.ld;
      allow update: if dono(e) && so(['rid']);   // v118.3: só a administração acrescenta a loja (rid) em códigos antigos
      allow delete: if dono(e);
    }

    // ---------- diárias ----------
    // ---------- equipe da loja: o lojista cadastra (pendente); só a administração autoriza e revoga ----------
    match /empresas/{e}/equipe/{id} {
      allow read: if dono(e) || (comSenha() && resource.data.get('ld', '') == request.auth.uid && acessoOk(e, resource.data.rid));   // v118.1
      allow create: if comSenha() && request.resource.data.ld == request.auth.uid
        && lojaDono(e, request.resource.data.rid) == request.auth.uid
        && acessoOk(e, request.resource.data.rid)
        && request.resource.data.st == 0
        && request.resource.data.keys().hasOnly(['id', 'rid', 'ld', 'nome', 'em', 'wa', 'fn', 'pm', 'st', 'ts']);
      allow update, delete: if dono(e);
    }

    // ---------- acessos do lojista: ele pede (pendente); só a administração autoriza, revoga e reautoriza; ninguém exclui ----------
    match /empresas/{e}/acessos/{id} {
      allow read: if dono(e) || (comSenha() && resource.data.get('ld', '') == request.auth.uid);   // v118.1: a consulta do app filtra por ld (antes a regra olhava uid e a consulta era recusada)
      allow create: if dono(e)
        || (comSenha() && request.resource.data.uid == request.auth.uid && request.resource.data.ld == request.auth.uid
            && id == string(request.resource.data.rid) + '_' + request.auth.uid
            && lojaDono(e, request.resource.data.rid) == request.auth.uid
            && request.resource.data.cargo == 'lojista' && request.resource.data.status == 'pendente'
            && request.resource.data.keys().hasOnly(['id', 'rid', 'uid', 'ld', 'email', 'cargo', 'status', 'criadoPor', 'criadoEm']));
      allow update: if dono(e);
      allow delete: if false;
    }

    // ---------- prova de ciência dos avisos de plano: só cria; nunca edita nem exclui ----------
    match /empresas/{e}/oks/{id} {
      allow read: if dono(e) || (comSenha() && resource.data.get('ld', '') == request.auth.uid && acessoOk(e, resource.data.rid));   // v118.1
      allow create: if (dono(e) || (comSenha() && lojaDono(e, request.resource.data.rid) == request.auth.uid))
        && request.resource.data.por == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'rid', 'ld', 'k', 'tipo', 'por', 'nm', 'ts', 'p']);
      allow update, delete: if false;
    }

    match /empresas/{e}/diarias/{id} {
      allow read: if dono(e) || (comSenha() && resource.data.get('ld', '') == request.auth.uid && acessoOk(e, resource.data.rid)) || entAprov(e);   // v118.1
      allow create: if dono(e)
        || (comSenha() && request.resource.data.ld == request.auth.uid
            && lojaDono(e, request.resource.data.rid) == request.auth.uid && acessoOk(e, request.resource.data.rid));   // v118.2
      allow update: if dono(e)
        || (comSenha() && resource.data.get('ld', '') == request.auth.uid && acessoOk(e, resource.data.rid) && so(['st']))
        || (entAprov(e) && so(['ens', 'st', 'en', 'enm']));
      allow delete: if dono(e) || (comSenha() && resource.data.get('ld', '') == request.auth.uid && acessoOk(e, resource.data.rid));   // v118.2
    }

    // ---------- indicações ----------
    match /empresas/{e}/ind/{id} {
      allow read: if dono(e)
        || (comSenha() && resource.data.alvo == request.auth.uid)
        || (comSenha() && resource.data.ref == 'e-' + request.auth.uid)
        || (comSenha() && resource.data.ref == 'le-' + request.auth.uid);
      allow create: if comSenha() && request.resource.data.get('st', 'pendente') == 'pendente'
        && ((request.resource.data.tipo == 'entregador' && request.resource.data.alvo == request.auth.uid)
            || (request.resource.data.tipo == 'lojista' && lojaDono(e, request.resource.data.alvo) == request.auth.uid));
      allow update: if dono(e) || (entAprov(e) && so(['st']));
      allow delete: if dono(e);
    }

    // ---------- métricas: cada aparelho grava só o próprio resumo (contagens, sem nome/telefone/endereço);
    //            só o criador do sistema lê, com e-mail verificado. Troque o e-mail abaixo antes de publicar. ----------
    match /empresas/{e}/metricas/{id} {
      allow read: if comSenha() && request.auth.token.email == 'edinaldooliveiradesouza@gmail.com' && request.auth.token.email_verified == true;
      allow create, update: if logado() && id == request.auth.uid && request.resource.data.id == request.auth.uid;
      allow delete: if false;
    }

    // ---------- configuração do sistema (Botões 1 e 2 do painel do criador): todos leem; só o criador grava ----------
    match /empresas/{e}/config/{id} {
      allow read: if logado();
      allow write: if logado() && request.auth.token.email == 'edinaldooliveiradesouza@gmail.com' && request.auth.token.email_verified == true;
    }

    // ---------- clientes: cada um só vê o próprio cadastro ----------
    match /empresas/{e}/cli/{id} {
      allow read: if dono(e) || (logado() && resource.data.id == request.auth.uid);
      allow create, update: if comSenha() && id == request.auth.uid && request.resource.data.id == request.auth.uid;
      allow delete: if dono(e) || (comSenha() && resource.data.get('id', '') == request.auth.uid);   // o cliente pode excluir o próprio cadastro
    }

    // ---------- contador de PEDIDOS do dia (15 por dia POR LOJA; o criador libera uma loja gravando lib=true nela; documento AAAA-MM-DD_idDaLoja) ----------
    // O contador sobe junto com cada pedido novo (mesma operação), e a regra recusa o pedido que passar do limite.
    match /empresas/{e}/dias/{d} {
      allow read: if logado();
      allow create: if dono(e) && request.resource.data.id == d
        && request.resource.data.keys().hasOnly(['id', 'n', 'oid'])
        && (!('n' in request.resource.data) || request.resource.data.n == 0)
        || (logado() && request.resource.data.id == d && request.resource.data.n == 1
            && request.resource.data.keys().hasOnly(['id', 'n', 'oid'])
            && (getAfter(pedDoc(e, request.resource.data.oid)).data.cid == request.auth.uid
                || getAfter(pedDoc(e, request.resource.data.oid)).data.ld == request.auth.uid));
      allow update: if logado() && request.resource.data.id == resource.data.id
        && request.resource.data.n == resource.data.get('n', 0) + 1
        && (resource.data.get('n', 0) < 15 || libOk(e, d))
        && so(['n', 'oid'])
        && (getAfter(pedDoc(e, request.resource.data.oid)).data.cid == request.auth.uid
            || getAfter(pedDoc(e, request.resource.data.oid)).data.ld == request.auth.uid);
      allow delete: if dono(e);
    }

    // ---------- tudo o mais é negado ----------
  }
}
